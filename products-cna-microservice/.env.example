# Copy to .env and adjust for your machine: cp .env.example .env

# PostgreSQL holds the catalog (listings, categories, inventory)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/products

# Elasticsearch backs /api/v1/search
ELASTIC_URL=http://localhost:9200
ELASTIC_INDEX=products
# Leave empty when security is off, as it is in the local compose file
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_APIKEY=
ELASTIC_TIMEOUT_MS=5000
ELASTIC_PING_TIMEOUT_MS=1500
ELASTIC_MAX_RETRIES=1

# Paging defaults applied by the list and search endpoints
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Load the demo catalog on start up
SEED_ON_START=false

CORS_ORIGINS=http://localhost:3000

# Used by the test suite only
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/products_test
